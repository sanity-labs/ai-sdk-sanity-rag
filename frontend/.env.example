# Same project ID as studio/.env
NEXT_PUBLIC_SANITY_PROJECT_ID=

# Same dataset as studio/.env
NEXT_PUBLIC_SANITY_DATASET=production

# Sanity API token with Viewer permissions (read-only)
# Create at sanity.io/manage -> Your Project -> API -> Tokens
SANITY_API_READ_TOKEN=

# Sanity API token with Editor permissions (for addResource and insights)
SANITY_API_WRITE_TOKEN=

# Vercel AI Gateway API key (powers streamText)
# Create at: vercel.com/dashboard/ai-gateway
AI_GATEWAY_API_KEY=

# Slug of the Sanity Context document in Studio (default: knowledge-base)
SANITY_CONTEXT_SLUG=knowledge-base

# Let the chat's addResource tool create knowledgeArticle documents when a user
# explicitly asks it to remember something. Off unless set to "true". Anything
# saved is shared with every user of the deployment, so leave it off on shared
# or multi-tenant deployments (see README → Write path).
ENABLE_CHAT_WRITES=true
