{
  "name": "ai-sdk-sanity-rag",
  "version": "1.0.0",
  "private": true,
  "description": "A retrieval-augmented generation chatbot powered by the Vercel AI SDK and Sanity Content Lake dataset embeddings.",
  "keywords": [
    "AI",
    "AI SDK",
    "Next.js",
    "RAG",
    "Sanity",
    "Sanity Context",
    "Semantic Search",
    "Vercel",
    "Vercel AI SDK"
  ],
  "homepage": "https://github.com/sanity-labs/ai-sdk-sanity-rag#readme",
  "bugs": {
    "url": "https://github.com/sanity-labs/ai-sdk-sanity-rag/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sanity-labs/ai-sdk-sanity-rag.git"
  },
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n studio,frontend -c '#f03e2f,#8b5cf6' 'pnpm --filter studio dev' 'pnpm --filter frontend dev'",
    "build": "pnpm --filter frontend build",
    "lint": "oxlint .",
    "check": "pnpm lint && pnpm typecheck && pnpm build",
    "typecheck": "pnpm -r typecheck",
    "bootstrap": "pnpm --filter studio bootstrap"
  },
  "devDependencies": {
    "@types/node": "^22.19.17",
    "concurrently": "^9.2.1",
    "oxlint": "^1.70.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20.19 <22 || >=22.12"
  },
  "packageManager": "pnpm@10.33.0"
}
