# Your Sanity project ID from sanity.io/manage.
# Use the same value for NEXT_PUBLIC_SANITY_PROJECT_ID in frontend/.env.local.
SANITY_STUDIO_PROJECT_ID=

# Dataset name, usually "production".
# Use the same value for NEXT_PUBLIC_SANITY_DATASET in frontend/.env.local.
SANITY_STUDIO_DATASET=production
